# Обязательно замените перед публикацией
POSTGRES_PASSWORD=replace-with-long-random-password
SESSION_SECRET=replace-with-48-random-bytes
DOMAIN=food.example.ru

# Локальный вход без SMS. Удалите в production.
DEV_SMS_CODE=2410

# Внешние источники
USDA_API_KEY=
# Каталог с распакованными CSV, например C:/data/usda (Windows) или /data/usda (Linux)
USDA_CSV_DIR=
OFF_USER_AGENT=NormaNutrition/1.0 (your-email@example.ru)

# Мультимодальная модель; ключ существует только на сервере
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
MOONSHOT_VISION_MODEL=kimi-k3
MOONSHOT_TEXT_MODEL=kimi-k2.6

# Универсальный HTTPS webhook вашего SMS-провайдера
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=

# Для локального API пароль должен совпадать с POSTGRES_PASSWORD выше
DATABASE_URL=postgres://norma:replace-with-long-random-password@127.0.0.1:5432/norma
PORT=3001
